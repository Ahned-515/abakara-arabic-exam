{
  "name": "abakara-arabic-exam",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test functions/test/*.test.js",
    "check": "node scripts/check.mjs",
    "serve": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "test:browser": "playwright test",
    "test:emulator": "firebase emulators:exec --project demo-abakara --only auth,firestore,functions \"node --test tests/emulator.test.js\"",
    "test:emulator:all": "firebase emulators:exec --project demo-abakara --only auth,firestore,functions \"node --test tests/emulator.test.js && playwright test\"",
    "test:emulator:tcp": "firebase emulators:exec --project demo-abakara --only auth,firestore \"node scripts/test-emulator.mjs\"",
    "test:emulator:all:tcp": "firebase emulators:exec --project demo-abakara --only auth,firestore \"node scripts/test-emulator.mjs --browser\""
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
